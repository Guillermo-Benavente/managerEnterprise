{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Node",
    "allowJs": true,
    "checkJs": false,
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "baseUrl": "./src",
    "paths": {
      "Components/*": ["renderer/components/*"],
      "Pages/*": ["renderer/pages/*"],
      "Routes/*": ["renderer/routes/*"],
      "Assets/*": ["renderer/assets/*"],
      "Types/*": ["types/*"]
    },
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "skipLibCheck": true
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist", "out", ".webpack"]
}